local function createLabel(text, y)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -30, 0, 25)
	label.Position = UDim2.fromOffset(15, y)
	label.Text = text
	label.TextSize = 16
	label.Font = Enum.Font.Gotham
	label.TextColor3 = Color3.new(1,1,1)
	label.BackgroundTransparency = 1
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame

	return label
end

--==================================================
-- SPEED
--==================================================

local speed = 16

local speedLabel = createLabel("Tốc độ: 16", 55)

local speedSlider = Instance.new("TextButton")
speedSlider.Size = UDim2.new(1, -30, 0, 22)
speedSlider.Position = UDim2.fromOffset(15, 83)
speedSlider.Text = ""
speedSlider.AutoButtonColor = false
speedSlider.BackgroundColor3 = Color3.fromRGB(65,65,65)
speedSlider.BorderSizePixel = 0
speedSlider.Parent = frame

local speedFill = Instance.new("Frame")
speedFill.Size = UDim2.new(speed / 500, 0, 1, 0)
speedFill.BackgroundColor3 = Color3.fromRGB(0,170,255)
speedFill.BorderSizePixel = 0
speedFill.Parent = speedSlider

local function setSpeed(x)
	local percent = math.clamp(
		(x - speedSlider.AbsolutePosition.X) /
		speedSlider.AbsoluteSize.X,
		0,
		1
	)

	speed = math.floor(percent * 500)

	speedLabel.Text = "Tốc độ: " .. speed
	speedFill.Size = UDim2.new(percent, 0, 1, 0)

	local character = player.Character
	local humanoid = character and
		character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid.WalkSpeed = speed
	end
end

local speedDragging = false

speedSlider.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		speedDragging = true
		setSpeed(input.Position.X)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if speedDragging then
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			setSpeed(input.Position.X)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		speedDragging = false
	end
end)

