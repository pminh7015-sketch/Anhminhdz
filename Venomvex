--==================================================
-- HITBOX
--==================================================

local hitboxEnabled = false
local hitboxSize = 4
local originalSizes = {}

local hitboxLabel = createLabel("Hitbox: 4", 220)

local hitboxSlider = Instance.new("TextButton")
hitboxSlider.Size = UDim2.new(1, -30, 0, 22)
hitboxSlider.Position = UDim2.fromOffset(15, 248)
hitboxSlider.Text = ""
hitboxSlider.AutoButtonColor = false
hitboxSlider.BackgroundColor3 = Color3.fromRGB(65,65,65)
hitboxSlider.BorderSizePixel = 0
hitboxSlider.Parent = frame

local hitboxFill = Instance.new("Frame")
hitboxFill.Size = UDim2.new(0, 0, 1, 0)
hitboxFill.BackgroundColor3 = Color3.fromRGB(255,80,80)
hitboxFill.BorderSizePixel = 0
hitboxFill.Parent = hitboxSlider

local function setHitboxSize(x)
	local percent = math.clamp(
		(x - hitboxSlider.AbsolutePosition.X) /
		hitboxSlider.AbsoluteSize.X,
		0,
		1
	)

	-- Hitbox từ 2 đến 20
	hitboxSize = math.floor(2 + percent * 18)

	hitboxLabel.Text = "Hitbox: " .. hitboxSize
	hitboxFill.Size = UDim2.new(percent, 0, 1, 0)
end

local hitboxDragging = false

hitboxSlider.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		hitboxDragging = true
		setHitboxSize(input.Position.X)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if hitboxDragging then
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			setHitboxSize(input.Position.X)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		hitboxDragging = false
	end
end)

