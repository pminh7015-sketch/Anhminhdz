-- LocalScript
-- Đặt vào StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local MIN_HITBOX = 2
local MAX_HITBOX = 500
local hitboxSize = 2
local hitboxEnabled = false
local rainbowBorder = true

local gui = Instance.new("ScreenGui")
gui.Name = "StudioUtilityMenu"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local main = Instance.new("Frame")
main.Size = UDim2.fromOffset(280, 235)
main.Position = UDim2.new(0.5, -140, 0.5, -117)
main.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
main.BorderSizePixel = 0
main.Parent = gui

Instance.new("UICorner", main).CornerRadius = UDim.new(0, 14)

local stroke = Instance.new("UIStroke")
stroke.Thickness = 3
stroke.Parent = main

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -20, 0, 40)
title.Position = UDim2.fromOffset(10, 5)
title.BackgroundTransparency = 1
title.Text = "🌈 STUDIO MENU"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 19
title.Font = Enum.Font.GothamBold
title.Parent = main

local function makeButton(text, y)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -30, 0, 38)
	b.Position = UDim2.fromOffset(15, y)
	b.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
	b.Text = text
	b.TextColor3 = Color3.new(1, 1, 1)
	b.TextSize = 15
	b.Font = Enum.Font.GothamBold
	b.Parent = main

	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

	return b
end

local hitboxButton = makeButton("HITBOX: TẮT", 50)
local borderButton = makeButton("VIỀN 7 MÀU: BẬT", 95)

local sizeLabel = Instance.new("TextLabel")
sizeLabel.Size = UDim2.new(1, -30, 0, 25)
sizeLabel.Position = UDim2.fromOffset(15, 140)
sizeLabel.BackgroundTransparency = 1
sizeLabel.Text = "Hitbox: 2 / 500"
sizeLabel.TextColor3 = Color3.new(1, 1, 1)
sizeLabel.TextSize = 15
sizeLabel.Font = Enum.Font.Gotham
sizeLabel.Parent = main

local sliderBack = Instance.new("Frame")
sliderBack.Size = UDim2.new(1, -30, 0, 12)
sliderBack.Position = UDim2.fromOffset(15, 170)
sliderBack.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
sliderBack.BorderSizePixel = 0
sliderBack.Parent = main

Instance.new("UICorner", sliderBack).CornerRadius = UDim.new(1, 0)

local slider = Instance.new("Frame")
slider.Size = UDim2.new(0, 0, 1, 0)
slider.BackgroundColor3 = Color3.fromRGB(80, 170, 255)
slider.BorderSizePixel = 0
slider.Parent = sliderBack

Instance.new("UICorner", slider).CornerRadius = UDim.new(1, 0)

local function getCharacter()
	return player.Character
end

local function getRoot()
	local character = getCharacter()
	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function updateHitbox()
	local root = getRoot()
	if not root then
		return
	end

	if hitboxEnabled then
		root.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
		root.Transparency = 0.5
		root.CanCollide = false
	else
		root.Size = Vector3.new(2, 2, 1)
		root.Transparency = 1
		root.CanCollide = false
	end
end

hitboxButton.MouseButton1Click:Connect(function()
	hitboxEnabled = not hitboxEnabled

	if hitboxEnabled then
		hitboxButton.Text = "HITBOX: BẬT"
		hitboxButton.BackgroundColor3 = Color3.fromRGB(55, 170, 85)
	else
		hitboxButton.Text = "HITBOX: TẮT"
		hitboxButton.BackgroundColor3 = Color3.fromRGB(170, 55, 55)
	end

	updateHitbox()
end)

borderButton.MouseButton1Click:Connect(function()
	rainbowBorder = not rainbowBorder

	borderButton.Text = rainbowBorder
		and "VIỀN 7 MÀU: BẬT"
		or "VIỀN 7 MÀU: TẮT"
end)

local draggingSlider = false

local function setSlider(x)
	local width = sliderBack.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local relative = math.clamp(
		(x - sliderBack.AbsolutePosition.X) / width,
		0,
		1
	)

	hitboxSize = math.floor(
		MIN_HITBOX + (MAX_HITBOX - MIN_HITBOX) * relative + 0.5
	)

	slider.Size = UDim2.new(relative, 0, 1, 0)
	sizeLabel.Text = "Hitbox: " .. hitboxSize .. " / 500"

	updateHitbox()
end

sliderBack.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		draggingSlider = true
		setSlider(input.Position.X)
	end
end)

UIS.InputChanged:Connect(function(input)
	if not draggingSlider then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		setSlider(input.Position.X)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		draggingSlider = false
	end
end)

-- Kéo menu
local draggingMenu = false
local dragStart
local startPosition

title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		draggingMenu = true
		dragStart = input.Position
		startPosition = main.Position
	end
end)

UIS.InputChanged:Connect(function(input)
	if not draggingMenu then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta = input.Position - dragStart

		main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		draggingMenu = false
	end
end)

player.CharacterAdded:Connect(function(character)
	character:WaitForChild("HumanoidRootPart")
	task.wait(0.2)

	if hitboxEnabled then
		updateHitbox()
	end
end)

local hue = 0

RunService.RenderStepped:Connect(function(dt)
	if rainbowBorder then
		hue = (hue + dt * 0.25) % 1
		stroke.Color = Color3.fromHSV(hue, 1, 1)
	end

	if hitboxEnabled then
		updateHitbox()
	end
end)
